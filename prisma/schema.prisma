// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
// USER -> BOOKS -> READLIST

enum BookStatus {
  PLANNING
  READING
  COMPLETED
}

model User {
  id        String @id @default(uuid())
  name      String 
  email     String @unique
  password  String
  createdAt DateTime @default(now())

  //relations
  books         Book[]        @relation("BookCreator")
  readListItems ReadListItem[]
}

model Book {
  id            String @id @default(uuid())
  title         String 
  overview      String?
  releaseYear   Int
  genres        String[] @default([])
  author        String
  createdById   String
  createdAt     DateTime @default(now())

  creator User @relation("BookCreator", fields: [createdById], references: [id], onDelete: Cascade)
  readListItems ReadListItem[]

  @@unique([title, author, releaseYear])
}

model ReadListItem {
  id        String @id @default(uuid())
  userId    String 
  bookId    String
  status    BookStatus @default(PLANNING)
  rating    Int? 
  notes     String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
}
