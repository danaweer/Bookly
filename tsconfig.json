  // Visit https://aka.ms/tsconfig to read more about this file
 {
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",

    "allowJs": true, //js exists along with ts
    "checkJs": false,

    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,

    "sourceMap": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.js"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}